# Build flags (safe for client)
VITE_AUTH_ENABLED=false

# Stripe Payment Links (public buy.stripe.com URLs — not secret keys).
# LIVE mode only on production. Success URL in Stripe Dashboard must include
# the exact placeholder {CHECKOUT_SESSION_ID}, for example:
#   Handbook → https://deepfocus.jeffsebiz.com/thanks?paid=1&product=handbook&session_id={CHECKOUT_SESSION_ID}
#   App      → https://deepfocus.jeffsebiz.com/thanks?paid=1&product=app&session_id={CHECKOUT_SESSION_ID}
# Do NOT put sk_live / sk_test secret keys in VITE_* vars.
# Do NOT use buy.stripe.com/test_* links on production.
VITE_STRIPE_HANDBOOK_PAYMENT_LINK=https://buy.stripe.com/28E9ALcsN6xx40s5mYgUM00
VITE_STRIPE_APP_PAYMENT_LINK=https://buy.stripe.com/cNi4grakFbRRgNecPqgUM01

# Optional internal-only $0 beta helper link (do not publish publicly):
# VITE_STRIPE_BETA_HELPER_PAYMENT_LINK=

# --- Server-only (Vercel env — never VITE_*, never commit real values) ---
# Restricted Stripe secret key with Checkout Sessions: Read.
# Required to unlock paid handbook downloads via /api/download.
# STRIPE_SECRET_KEY=
# Optional HMAC secret for short-lived signed download URLs.
# If unset, derived from STRIPE_SECRET_KEY.
# DOWNLOAD_SIGNING_SECRET=
